# Copy this file to .env.local and fill in your own values.

# Supabase — create a free project at https://supabase.com
# Project Settings → API → Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Operator PIN — used for the /admin page (choose any 6-digit number)
NEXT_PUBLIC_OPERATOR_PIN=123456

# Google Gemini — create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
